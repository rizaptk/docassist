<?xml version="1.0" encoding="UTF-8"?>
<!-- DocAssist — Add-in only manifest, sideload manual. Ganti rizaptk.github.io/docassist dengan URL hosting statis kamu. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="TaskPaneApp">
  <Id>f87ed71d-c451-4aa9-a9e0-baff31864bd7</Id>
  <Version>1.0.0</Version>
  <ProviderName>DocAssist</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="DocAssist AI"/>
  <Description DefaultValue="Asisten operasional Word: format/edit/tambah/desain via chat widget ringan (BYOK OpenAI+Gemini)."/>
  <IconUrl DefaultValue="https://rizaptk.github.io/docassist/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://rizaptk.github.io/docassist/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://rizaptk.github.io/docassist/docs/PANDUAN_INSTALL.html"/>
  <AppDomains>
    <AppDomain>https://rizaptk.github.io/docassist</AppDomain>
    <AppDomain>https://api.openai.com</AppDomain>
    <AppDomain>https://generativelanguage.googleapis.com</AppDomain>
    <AppDomain>https://api.groq.com</AppDomain>
    <AppDomain>https://openrouter.ai</AppDomain>
    <AppDomain>https://api.cerebras.ai</AppDomain>
    <AppDomain>https://api.mistral.ai</AppDomain>
    <AppDomain>https://router.huggingface.co</AppDomain>
    <AppDomain>https://api.sambanova.ai</AppDomain>
    <AppDomain>https://integrate.api.nvidia.com</AppDomain>
    <AppDomain>https://text.pollinations.ai</AppDomain>
    <AppDomain>https://api.deepseek.com</AppDomain>
    <AppDomain>https://api.anthropic.com</AppDomain>
    <!-- Ollama lokal (Word Desktop). Tambahkan domain provider custom lain di sini. -->
    <AppDomain>http://localhost:11434</AppDomain>
    <AppDomain>https://cdn.jsdelivr.net</AppDomain>
  </AppDomains>
  <Hosts><Host Name="Document"/></Hosts>
  <!-- Lantai install: WordApi 1.1 agar bisa dipasang di Office 2016+. Fitur baru (komentar=1.4, shapes/PageSetup=Desktop) dibatasi saat runtime via isSetSupported/try-catch. SharedRuntime TIDAK wajib agar 2016/2019 bisa install; hide()/visibility auto-fallback ke collapse. -->
  <Requirements><Sets DefaultMinVersion="1.1"><Set Name="WordApi" MinVersion="1.1"/></Sets></Requirements>
  <DefaultSettings><SourceLocation DefaultValue="https://rizaptk.github.io/docassist/src/taskpane/taskpane.html"/></DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xsi:type="VersionOverridesV1_0">
    <Hosts><Host xsi:type="Document">
      <DesktopFormFactor>
        <GetStarted><Title resid="GetStarted.Title"/><Description resid="GetStarted.Desc"/><LearnMoreUrl resid="GetStarted.Url"/></GetStarted>
        <FunctionFile resid="Commands.Url"/>
        <ExtensionPoint xsi:type="PrimaryCommandSurface">
          <OfficeTab id="TabHome"><Group id="DocAssist.Group">
            <Label resid="Group.Label"/>
            <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
            <Control xsi:type="Button" id="DocAssist.Toggle">
              <Label resid="Toggle.Label"/><Supertip><Title resid="Toggle.Title"/><Description resid="Toggle.Desc"/></Supertip>
              <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
              <Action xsi:type="ShowTaskpane"><TaskpaneId>DocAssistPane</TaskpaneId><SourceLocation resid="Pane.Url"/></Action>
            </Control>
            <Control xsi:type="Button" id="DocAssist.Collapse">
              <Label resid="Collapse.Label"/><Supertip><Title resid="Collapse.Title"/><Description resid="Collapse.Desc"/></Supertip>
              <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
              <Action xsi:type="ExecuteFunction"><FunctionName>toggleCollapse</FunctionName></Action>
            </Control>
          </Group></OfficeTab>
        </ExtensionPoint>
      </DesktopFormFactor>
    </Host></Hosts>
    <Resources>
      <bt:Images xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0">
        <bt:Image id="Icon.16" DefaultValue="https://rizaptk.github.io/docassist/assets/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://rizaptk.github.io/docassist/assets/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://rizaptk.github.io/docassist/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0">
        <bt:Url id="Pane.Url" DefaultValue="https://rizaptk.github.io/docassist/src/taskpane/taskpane.html"/>
        <bt:Url id="Commands.Url" DefaultValue="https://rizaptk.github.io/docassist/src/taskpane/commands.html"/>
        <bt:Url id="GetStarted.Url" DefaultValue="https://rizaptk.github.io/docassist/docs/PANDUAN_INSTALL.html"/>
      </bt:Urls>
      <bt:ShortStrings xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0">
        <bt:String id="GetStarted.Title" DefaultValue="DocAssist siap."/>
        <bt:String id="Group.Label" DefaultValue="DocAssist"/>
        <bt:String id="Toggle.Label" DefaultValue="AI Asisten"/>
        <bt:String id="Collapse.Label" DefaultValue="Ringkas"/>
        <bt:String id="Toggle.Title" DefaultValue="Buka/tutup asisten AI"/>
        <bt:String id="Collapse.Title" DefaultValue="Mode strip hemat tempat"/>
      </bt:ShortStrings>
      <bt:LongStrings xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0">
        <bt:String id="GetStarted.Desc" DefaultValue="Chat widget ringan, tidak mengganggu dokumen."/>
        <bt:String id="Toggle.Desc" DefaultValue="Tampilkan panel chat 330px yang bisa dilipat."/>
        <bt:String id="Collapse.Desc" DefaultValue="Lipat jadi strip ikon agar tidak intrusif."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
